{
  "name": "patchwerk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Modular, patch-cable visual synth for music: a track goes in, a node graph of shaders comes out.",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test test/*.test.mjs",
    "check:shaders": "node test/compile-check.mjs",
    "smoke": "node test/smoke.mjs",
    "interact": "node test/interact.mjs",
    "presets": "node test/presets.mjs",
    "perf": "node test/perf.mjs",
    "ai-live": "node test/ai-live.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fltman/patchwerk"
  }
}
